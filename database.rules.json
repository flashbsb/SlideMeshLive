{
  "rules": {
    "sessions": {
      "$sessionId": {
        // Leitura pública em tempo real do estado da sessão para telões e smartphones
        ".read": true,

        // Estado da Apresentação e Enquetes (Palestrante e Mesa Técnica)
        "currentSlide": { ".write": "auth != null || !data.exists()" },
        "slideId": { ".write": "auth != null || !data.exists()" },
        "slideTitle": { ".write": "auth != null || !data.exists()" },
        "status": { ".write": "auth != null || !data.exists()" },
        "activePoll": { ".write": "auth != null || !data.exists()" },
        "pollStatus": { ".write": "auth != null || !data.exists()" },
        "showResults": { ".write": "auth != null || !data.exists()" },
        "showFinalAnalytics": { ".write": "auth != null || !data.exists()" },
        "featuredQuestion": { ".write": "auth != null || !data.exists()" },
        "updatedAt": { ".write": "auth != null || !data.exists()" },

        // Registro de presença do participante
        "participants": {
          "$participantId": {
            ".write": true,
            ".validate": "newData.hasChildren(['lastSeen', 'active'])"
          }
        },

        // Votação com voto único garantido por UID
        "votes": {
          ".write": "auth != null || !data.exists()",
          "$pollId": {
            ".write": "auth != null || !data.exists()",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "!data.exists() && newData.hasChildren(['optionId', 'timestamp'])"
            }
          }
        },

        // Perguntas do público com suporte a moderação
        "questions": {
          ".write": "auth != null || !data.exists()",
          "$questionId": {
            ".write": "auth != null || !data.exists()",
            ".validate": "newData.hasChildren(['text', 'uid', 'status', 'timestamp']) || !newData.exists()"
          }
        }
      }
    }
  }
}
