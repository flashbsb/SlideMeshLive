# ==============================================================================
# .gitignore — SlideMeshLive (Plataforma de Apresentação HTML Interativa)
# Proteção estrita de credenciais, dados analíticos e temporários para o GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURANÇA, CREDENCIAIS E CONTAS SENSÍVEIS
# ------------------------------------------------------------------------------
# Arquivo com senhas, PINs e e-mails reais de produção
config/security.json
config/security.local.json
config/admin-keys.json
config/*.tmp
config/.*.tmp

# Preserva explicitamente o modelo de referência público
!config/security.example.json
!config/security.default.json

# Arquivos de ambiente e variáveis locais
.env
.env.*
!.env.example
*.env

# Chaves de API, Certificados e Contas de Serviço (Firebase / GCP / AWS / SSH)
service-account*.json
firebase-adminsdk*.json
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# Configurações com credenciais privadas locais
js/config.local.js
config.local.js

# ------------------------------------------------------------------------------
# 2. DADOS ANALÍTICOS, HISTÓRICOS E EXPORTAÇÕES LOCAIS
# ------------------------------------------------------------------------------
# Históricos analíticos gerados no servidor em tempo de execução
sessions_archive/*.json
!sessions_archive/.gitkeep

# Relatórios e pacotes exportados pelo moderador ou participantes
export_*.json
apresentacao_export_*.json
relatorio_*.json
relatorio_*.csv
*.slidemesh.zip
backup_*.zip

# Bancos de dados locais
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 3. CACHES E AMBIENTES PYTHON
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 4. LOGS, RASCUNHOS E ARQUIVOS TEMPORÁRIOS
# ------------------------------------------------------------------------------
scratch/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.temp/
.tmp/
tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. DEPENDÊNCIAS E BUILDS
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.package/

# ------------------------------------------------------------------------------
# 6. ARQUIVOS DE SISTEMA OPERACIONAL
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.fuse_hidden*

# ------------------------------------------------------------------------------
# 7. IDES, EDITORES E AMBIENTES DE DESENVOLVIMENTO
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace
