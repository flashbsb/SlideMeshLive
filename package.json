{
  "name": "slidemesh-live",
  "version": "1.0.0",
  "description": "SlideMeshLive — Plataforma de Apresentação HTML Interativa e Sincronizada em Tempo Real",
  "homepage": "https://github.com/flashbsb/SlideMeshLive#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/flashbsb/SlideMeshLive.git"
  },
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "npx -y serve . -l 8080 -s",
    "dev": "npx -y live-server --port=8080 --no-browser --entry-file=index.html",
    "serve": "npx -y serve . -l 8080",
    "py": "python3 server.py",
    "test": "python3 tests/test_suite.py"
  },
  "keywords": [
    "presentation",
    "realtime",
    "slides",
    "firebase",
    "audience-interaction"
  ],
  "author": "Engenharia de Soluções",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "serve": "^14.2.4"
  }
}
